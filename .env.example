# Copiar a .env.local y completar.

# Postgres local de compose.yaml. En Supabase: Project Settings > Database > Connection string,
# modo "Transaction pooler" (puerto 6543).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/planes

# Opcional. URL pública para los links y el QR (por ejemplo https://planes.vercel.app).
# Si queda vacía se usa la dirección con la que se abrió la página.
NEXT_PUBLIC_SITE_URL=

# Opcional. Nombre provisorio de la app.
NEXT_PUBLIC_APP_NAME=Tiki

# Firma de los QR de encuentro. Cualquier texto largo y aleatorio, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCOUNTER_SECRET=

# Clave del HMAC con el que el MCP guarda las IP en su registro. Otro texto aleatorio, con el mismo comando.
MCP_LOG_SECRET=
